<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Activity 主题只负责启动窗口背景与状态栏外观，
      界面全部由 Compose 的 DsTheme 接管（含浅色/深色/跟随系统三态）。
    -->
    <style name="Theme.DailySchedule" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
